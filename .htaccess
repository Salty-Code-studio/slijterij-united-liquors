# Slijterij United Liquors — Apache config (GoDaddy cPanel)

RewriteEngine On

# Force HTTPS (301)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host: force non-www (matches the site's canonical URL)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Branded 404 page
ErrorDocument 404 /404.html

# Cache static assets (URLs are version-stamped, e.g. ?v=4, so this is safe)
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML must always revalidate, or browsers serve a stale page that still
  # points at old ?v= asset URLs — updates would never reach repeat visitors.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Force HTML to revalidate on every load (works even where mod_expires is off).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# Gzip text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
